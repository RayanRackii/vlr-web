# Copy to .env.e2e.local (never commit the local file).
# Required for `npm run test:e2e:release`.

E2E_ENV=development
E2E_WEB_URL=https://vlr-web-git-develop-vlr-solutions.vercel.app
E2E_API_URL=https://vlr-api-development.up.railway.app

E2E_PLATFORM_ADMIN_EMAIL=
E2E_PLATFORM_ADMIN_PASSWORD=

E2E_B2B_EMAIL=
E2E_B2B_PASSWORD=

E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=

# Optional. Discovered from GET /api/users/me when blank.
E2E_TARGET_TENANT_ID=
E2E_TARGET_TENANT_SLUG=

E2E_ALLOW_MUTATIONS=true
E2E_RESTORE_ORIGINAL_TENANT_STATE=true
