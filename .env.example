# Supabase (Auth only — never use the service role key in the frontend)
# Project URL from Supabase Dashboard → Settings → API (without /rest/v1)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# .NET API base URL (local or Fly.io)
# Example DEV: https://rolvix-api-dev.fly.dev
VITE_API_URL=http://localhost:5298

# Platform Super-Admin emails (comma-separated). Must match PlatformAdmin:Emails on the API.
VITE_PLATFORM_ADMIN_EMAILS=you@example.com

# Public base domain shown in subdomain preview ({subdomain}.{base})
VITE_TENANT_BASE_DOMAIN=rolvix.com.br
